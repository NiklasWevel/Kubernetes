{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "enabledManagers": [
    "docker-compose",
    "helm-values",
    "helmfile",
    "kustomize",
    "kubernetes",
    "custom.regex",
    "flux"
  ],
  "schedule": ["before 8am"],
  "timezone": "Europe/Berlin",
  "prHourlyLimit": 0,
  "commitMessageAction": "update",
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "matchDatasources": ["docker"],
      "allowedVersions": "/^v?[0-9]+(\\.[0-9]+){0,2}$/"
    },
    {
      "description": "Helm chart updates in flux HelmReleases: automerge patch only",
      "matchDatasources": ["helm"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "matchDepNames": ["siderolabs/talos"],
      "automerge": false
    },
    {
      "description": "kubelet must match the running control plane: merge only after talosctl upgrade-k8s, together with --kubernetes-version",
      "matchPackageNames": ["ghcr.io/siderolabs/kubelet"],
      "automerge": false
    }
  ],
  "kubernetes": {
    "managerFilePatterns": ["/\\.ya?ml$/"]
  },
  "flux": {
    "managerFilePatterns": ["/\\.ya?ml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track Talos releases via the Image Factory installer reference",
      "managerFilePatterns": ["/^talos/patches/.+\\.ya?ml$/"],
      "matchStrings": [
        "factory\\.talos\\.dev/(?:installer|metal-installer)/[a-f0-9]+:(?<currentValue>v[\\d.]+)"
      ],
      "depNameTemplate": "siderolabs/talos",
      "datasourceTemplate": "github-releases"
    }
  ]
}